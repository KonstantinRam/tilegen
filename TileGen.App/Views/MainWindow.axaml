<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TileGen.App.ViewModels"
        xmlns:views="using:TileGen.App.Views"
        x:Class="TileGen.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Width="1560" Height="980" MinWidth="1200" MinHeight="760">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding AddFavoriteCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportSetCommand}" />
  </Window.KeyBindings>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="Open settings.json..." Command="{Binding OpenSettingsCommand}" />
        <MenuItem Header="Choose output folder..." Command="{Binding ChooseOutputFolderCommand}" />
        <MenuItem Header="Write contact sheet on export" ToggleType="CheckBox" IsChecked="{Binding WriteContactSheet, Mode=TwoWay}" />
        <Separator />
        <MenuItem Header="Export set" Command="{Binding ExportSetCommand}" InputGesture="Ctrl+E" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Palette from image..." Command="{Binding PaletteFromImageCommand}" />
        <MenuItem Header="Reset to preset defaults" Command="{Binding ResetToPresetDefaultsCommand}" />
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderBrush="#444444" BorderThickness="0,1,0,0">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True" IsVisible="{Binding IsRendering}" Width="120" Margin="8,0,0,0" />
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid ColumnDefinitions="1*,1*,1.35*" Margin="6">
      <views:MaterialColumnView Grid.Column="0" DataContext="{Binding Wall}" Margin="0,0,6,0" />
      <views:MaterialColumnView Grid.Column="1" DataContext="{Binding Floor}" Margin="0,0,6,0" />
      <Grid Grid.Column="2" RowDefinitions="*,Auto">
        <Border Grid.Row="0" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="6">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,6">
              <TextBlock Grid.Column="0" Text="Room preview" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="zoom" VerticalAlignment="Center" Margin="8,0,4,0" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding Room.Zooms}" SelectedItem="{Binding Room.Zoom, Mode=TwoWay}" Width="80" />
              <TextBlock Grid.Column="3" Text="room" VerticalAlignment="Center" Margin="8,0,4,0" />
              <NumericUpDown Grid.Column="4" Minimum="4" Maximum="16" Increment="1" FormatString="0" Value="{Binding Room.RoomSize, Mode=TwoWay}" Width="110" />
              <CheckBox Grid.Column="5" Content="full size" IsChecked="{Binding Room.FullSize, Mode=TwoWay}" Margin="8,0,0,0"
                        ToolTip.Tip="Render the previews at the export size instead of 256, which is slower and shows the fine octaves" />
            </Grid>
            <ScrollViewer HorizontalScrollBarVisibility="{Binding Room.IsFit, Converter={StaticResource FitToScroll}}"
                          VerticalScrollBarVisibility="{Binding Room.IsFit, Converter={StaticResource FitToScroll}}">
              <views:RoomPreviewControl DataContext="{Binding Room}" />
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,6,0,0" Height="320">
          <Border Grid.Column="0" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,6,0">
            <TabControl>
              <TabItem Header="Presets">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <Button Content="Load" Command="{Binding LoadPresetCommand}" ToolTip.Tip="Replace the parameters with the preset defaults and draw a new seed" />
                    <Button Content="Save as..." Command="{Binding SaveAsPresetCommand}" ToolTip.Tip="Write the current parameters and ranges as a new preset file" />
                    <Button Content="Delete" Command="{Binding DeletePresetCommand}" />
                  </StackPanel>
                  <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PresetEntryViewModel">
                        <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Path}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </TabItem>
              <TabItem Header="Favorites">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <Button Content="Load" Command="{Binding LoadFavoriteCommand}" ToolTip.Tip="Restore the preset, seed, size and variant count" />
                    <Button Content="Rename..." Command="{Binding RenameFavoriteCommand}" />
                    <Button Content="Delete" Command="{Binding DeleteFavoriteCommand}" />
                  </StackPanel>
                  <ListBox ItemsSource="{Binding Favorites}" SelectedItem="{Binding SelectedFavorite, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:FavoriteViewModel">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" />
                          <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="11" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </TabItem>
            </TabControl>
          </Border>
          <Border Grid.Column="1" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="8">
            <StackPanel Spacing="6">
              <TextBlock Text="Set" FontWeight="Bold" FontSize="16" />
              <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" >
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Set name" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SetName, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Sizes}" SelectedItem="{Binding Size, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Variants" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="4" Maximum="99" Increment="1" FormatString="0" Value="{Binding VariantCount, Mode=TwoWay}" Margin="0,2" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Base seed" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BaseSeedText, Mode=TwoWay}" Margin="0,2" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Reroll seed" Command="{Binding RerollSeedCommand}" ToolTip.Tip="Space: new seed, same parameters" />
                <Button Content="Randomize" Command="{Binding RandomizeParametersCommand}" ToolTip.Tip="Draw every ranged parameter from its range, keep the seed" />
                <Button Content="Roll both" Command="{Binding RollBothCommand}" ToolTip.Tip="New seed and randomized parameters" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="Add favorite" Command="{Binding AddFavoriteCommand}" ToolTip.Tip="Ctrl+S" />
                <Button Content="Export set..." Command="{Binding ExportSetCommand}" ToolTip.Tip="Ctrl+E: write floor_NN.png, wall_NN.png and settings.json" Classes="accent" />
              </StackPanel>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsExporting}" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
