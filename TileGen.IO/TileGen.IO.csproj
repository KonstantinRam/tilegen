<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TileGen.IO</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TileGen.Core/TileGen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- The Linux natives let the tests, the CLI and the GUI run on a Linux development machine, and Avalonia depends on the same package. The client runs Windows, where the SkiaSharp package carries its own natives. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
  </ItemGroup>

</Project>
